# Industrial Failure Intelligence Agent (IFIA) - Configuration
PORT=3001
NODE_ENV=development

# Optional Claude API Key for live Anthropic reasoning
# If left empty, IFIA uses its built-in Engineering Domain Reasoning Engine
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# CMMS Integration Mode: SANDBOX | MAXIMO_REST | SAP_PM_REST
CMMS_MODE=SANDBOX
CMMS_SANDBOX_LATENCY_MS=150

# Exact browser origins allowed to call the API (comma-separated; use HTTPS in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Storage Path for Persistent Case State & Audit Logs
STORAGE_DIR=./data_store

# Engineering Governance & Security
REQUIRE_HUMAN_APPROVAL_FOR_CMMS=true
ENABLE_PROMPT_INJECTION_SHIELD=true

# Cryptographic Authentication Secret (Mandatory in production; min 32 chars / 256-bit)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
